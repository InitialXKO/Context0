{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "web/app/api/ai-suggest/route.ts": {
      "runtime": "edge",
      "regions": ["iad1", "sfo1"]
    }
  },
  "redirects": [
    {
      "source": "/docs",
      "destination": "https://github.com/ct0-ai",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
